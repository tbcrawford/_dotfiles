#!/bin/sh
# ~/.claude.json is mostly Claude Code's own state, so only the user-scope MCP servers are managed here.
set -eu

current="$(cat)"
[ -n "$current" ] || current='{}'

printf '%s\n' "$current" | jq '.mcpServers = ((.mcpServers // {}) + {
  "codegraph": {"type": "stdio", "command": "codegraph", "args": ["serve", "--mcp"]},
  "executor": {"type": "stdio", "command": "executor", "args": ["mcp"], "env": {}}
})'
