#!/bin/sh
# ~/.claude.json is mostly Claude Code's own state, so only the user-scope MCP servers are managed here.
set -eu

current="$(cat)"
[ -n "$current" ] || current='{}'

# Claude Code writes the file without a trailing newline; match it so apply stays a no-op.
printf '%s' "$(printf '%s\n' "$current" | jq '.mcpServers = ((.mcpServers // {}) + {
  "executor": {"type": "http", "url": "http://127.0.0.1:4312/mcp"}
})')"
