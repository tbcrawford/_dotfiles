# Config generated by Ghostty Config

scrollback-limit = 10000000
clipboard-read = allow
clipboard-write = allow
window-colorspace = display-p3
window-padding-x = 5
window-height = 28
window-width = 111
theme = Nord
bold-is-bright = false
font-size = 14
font-thicken = true
font-family = Hack JBM L Nerd Font
adjust-cell-width = -6%
adjust-cell-height = 8%
# background-opacity = 0.94
background-blur = true
keybind = super+ctrl+l=goto_split:right
keybind = super+ctrl+j=goto_split:bottom
keybind = super+ctrl+h=goto_split:left
keybind = super+ctrl+k=goto_split:top
macos-titlebar-style = hidden
# macos-titlebar-style = tabs
macos-option-as-alt = true
alpha-blending = native
macos-icon = custom
macos-custom-icon = {{ .chezmoi.homeDir }}/.config/ghostty/nord-ghostty-light-macos.icns
window-padding-x = 14
window-padding-y = 12
