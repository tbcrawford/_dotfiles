{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "executor": {
      "type": "local",
      "command": ["executor", "mcp"],
      "enabled": true
    }
  },
  "permission": {
    "external_directory": {
      "~/": "allow",
      "~/**": "allow"
    },
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*.env.sample": "allow"
    },
    "edit": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*.env.sample": "allow"
    },
    "bash": {
      "*": "allow",
      "env": "deny",
      "printenv": "deny",
      "printenv *": "deny",
      "op read *": "deny",
      "op environment read *": "deny",
      "*.env": "deny",
      "*.env *": "deny",
      "*.env.local*": "deny",
      "*.env.development*": "deny",
      "*.env.production*": "deny",
      "*.env.staging*": "deny",
      "*.env.test*": "deny"
    }
  }
}
