{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "executor": {
      "type": "local",
      "command": ["executor", "mcp"],
      "enabled": true
    }
  },
  "permission": {
    "external_directory": {
      "~/": "allow",
      "~/**": "allow"
    },
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*.env.sample": "allow"
    },
    "edit": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*.env.sample": "allow"
    },
    "bash": {
      "*": "allow",
      "env": "deny",
      "printenv": "deny",
      "printenv *": "deny",
      "op read *": "deny",
      "op environment read *": "deny",
      "op environment secret *": "deny",
      "op item get *": "deny",
      "op inject*": "deny",
      "op run *--no-masking*": "deny",
      "fnox *get*": "deny",
      "fnox *export*": "deny",
      "fnox *env*": "deny",
      "fnox *edit*": "deny",
      "fnox *--values*": "deny",
      "fnox *-V*": "deny",
      "mise env*": "deny",
      "security find-generic-password*": "deny",
      "security find-internet-password*": "deny",
      "security dump-keychain*": "deny",
      "export -p*": "deny",
      "docker compose config*": "deny",
      "docker-compose config*": "deny",
      "docker inspect*": "deny",
      "*.env": "deny",
      "*.env *": "deny",
      "*.env.local*": "deny",
      "*.env.development*": "deny",
      "*.env.production*": "deny",
      "*.env.staging*": "deny",
      "*.env.test*": "deny"
    }
  }
}
