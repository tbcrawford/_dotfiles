{
  "theme": "dark",
  "permissions": {
    "deny": [
      "Bash(docker compose config:*)",
      "Bash(docker inspect:*)",
      "Bash(env)",
      "Bash(export -p)",
      "Bash(fnox edit:*)",
      "Bash(fnox env:*)",
      "Bash(fnox export:*)",
      "Bash(fnox get:*)",
      "Bash(fnox list --values:*)",
      "Bash(fnox list -V:*)",
      "Bash(mise env:*)",
      "Bash(op environment read:*)",
      "Bash(op environment secret:*)",
      "Bash(op inject:*)",
      "Bash(op item get:*)",
      "Bash(op read:*)",
      "Bash(op run --no-masking:*)",
      "Bash(printenv)",
      "Bash(printenv:*)",
      "Bash(security dump-keychain:*)",
      "Bash(security find-generic-password:*)",
      "Bash(security find-internet-password:*)",
      "Edit(**/.env)",
      "Edit(**/.env.*.local)",
      "Edit(**/.env.development)",
      "Edit(**/.env.local)",
      "Edit(**/.env.production)",
      "Edit(**/.env.staging)",
      "Edit(**/.env.test)",
      "Read(**/.env)",
      "Read(**/.env.*.local)",
      "Read(**/.env.development)",
      "Read(**/.env.local)",
      "Read(**/.env.production)",
      "Read(**/.env.staging)",
      "Read(**/.env.test)"
    ]
  }
}
