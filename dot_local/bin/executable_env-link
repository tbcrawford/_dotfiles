#!/bin/sh
# Symlink a checkout's .env to a 1Password-mounted .env (a named pipe).
# Looks for, in order:
#   $ENV_LINK_ROOT/.secrets/<repo>/.env   per-repo mount
#   $ENV_LINK_ROOT/.env                   shared mount for every repo
# ENV_LINK_ROOT defaults to ~/dev/home.
# Usage: env-link [checkout-dir]   (defaults to the current directory)
set -eu

root=${ENV_LINK_ROOT:-$HOME/dev/home}
top=$(git -C "${1:-.}" rev-parse --show-toplevel)
repo=$(basename "$(git -C "$top" remote get-url origin)" .git)
dst="$top/.env"

if [ -p "$root/.secrets/$repo/.env" ]; then
  src="$root/.secrets/$repo/.env"
elif [ -p "$root/.env" ]; then
  src="$root/.env"
else
  echo "env-link: no 1Password mount for $repo under $root; skipping" >&2
  exit 0
fi
if [ -e "$dst" ] && [ ! -L "$dst" ]; then
  echo "env-link: $dst is a regular file; move it into 1Password first" >&2
  exit 1
fi
# Keep the link out of git without touching the repo's .gitignore.
if ! git -C "$top" check-ignore -q .env; then
  exclude=$(git -C "$top" rev-parse --path-format=absolute --git-path info/exclude)
  mkdir -p "$(dirname "$exclude")"
  printf '/.env\n' >> "$exclude"
fi

ln -sfn "$src" "$dst"
echo "$dst -> $src"
